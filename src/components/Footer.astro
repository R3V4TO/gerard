---
import company from '../data/company.json';
---

<footer class="site-footer">
  <div class="container-wide footer-studio">
    <div class="footer-studio__grid">
      <div>
        <a href="/" class="footer-studio__logo-link">
          <span class="footer-studio__logo-lockup">
            <img
              class="footer-studio__logo-mark"
              src={`${company.logo.markLight}?v=4`}
              alt={company.name}
              width="52"
              height="82"
              decoding="async"
            />
            <span class="footer-studio__wordmark">
              <span class="footer-studio__wordmark-name">{company.personName}</span>
              <span class="footer-studio__wordmark-tag">{company.tagline}</span>
            </span>
          </span>
        </a>
        <p class="footer-studio__tagline">{company.specialization}</p>
        <p class="mt-2 text-sm text-dark-muted">{company.location}</p>
        <p class="mt-1">
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </div>
      <div class="footer-studio__cols">
        <div>
          <p class="footer-studio__heading">Navigation</p>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/work">Works</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/cv">CV</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-studio__heading">Projects</p>
          <ul>
            {
              company.work.items.map((item) => (
                <li><a href={item.caseStudy}>{item.title}</a></li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bar">
    <div class="container-wide footer-bar__row">
      <p>© {new Date().getFullYear()} {company.personName}. Personal reference site.</p>
      <p class="text-dark-muted">{company.name}</p>
    </div>
  </div>
</footer>
