---
interface Props {
  formId: string;
  statusId: string;
  source: string;
  buttonLabel?: string;
  buttonClass?: string;
  consentText: string;
  showHoneypot?: boolean;
  inputClass?: string;
}

const {
  formId,
  statusId,
  source,
  buttonLabel = 'Subscribe',
  buttonClass = 'btn-light w-fit cursor-pointer border-0',
  consentText,
  showHoneypot = true,
  inputClass = 'input-field',
} = Astro.props;

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const guideUrl = '/guide/web-app-vs-mobile';
const downloadUrl = '/downloads/versacarte-web-vs-mobile-guide.html';
---

<form class="subscribe-form space-y-4" id={formId}>
  {showHoneypot && (
    <div class="hidden" aria-hidden="true">
      <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
    </div>
  )}
  <input type="email" name="email" required class={inputClass} placeholder="Email" autocomplete="email" />
  <label class="checkbox-row">
    <input type="checkbox" name="consent" required />
    <span>{consentText}</span>
  </label>
  <button type="submit" class={buttonClass}>{buttonLabel}</button>
  <p id={statusId} class="text-sm text-dark-muted subscribe-form__status" role="status"></p>
  <div class="subscribe-form__success hidden" data-guide-success>
    <p class="text-sm text-dark-muted">Your guide is ready:</p>
    <a href={guideUrl} class="link-arrow mt-2">Read online</a>
    <a href={downloadUrl} class="link-arrow mt-2 block" download>Download copy</a>
  </div>
</form>

<script define:vars={{ formId, statusId, source, web3formsKey, guideUrl, downloadUrl }}>
  const form = document.getElementById(formId);
  const status = document.getElementById(statusId);
  if (!form || !status) throw new Error('Subscribe form elements missing');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!web3formsKey) {
      status.textContent = 'Subscribe is not configured. Email owner@versacarte.com for the guide.';
      return;
    }

    status.textContent = 'Subscribing…';
    const successBox = form.querySelector('[data-guide-success]');
    successBox?.classList.add('hidden');

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const botcheck = String(data.get('botcheck') ?? '');

    if (botcheck) return;

    const message = [
      'New mailing list subscriber',
      `Email: ${email}`,
      `Source: ${source}`,
      'Guide: Web App vs Mobile App Decision Guide',
      'Consent: yes',
      `Guide URL: ${window.location.origin}${guideUrl}`,
    ].join('\n');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: web3formsKey,
          name: email,
          email,
          subject: `Mailing list + guide: ${email}`,
          message,
          from_name: 'VersaCarte Subscribe',
          replyto: email,
          botcheck: '',
        }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        status.textContent = 'Subscribed. Your guide is ready below.';
        successBox?.classList.remove('hidden');
        form.reset();

        fetch('/api/send-guide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email }),
        }).catch(() => {});
      } else {
        status.textContent = result.message ?? 'Something went wrong. Try again.';
      }
    } catch {
      status.textContent = 'Network issue. Try again when online.';
    }
  });
</script>
