---
const params = Astro.url.searchParams;
const prefillType = params.get('type') ?? '';
const prefillPackage = params.get('package') ?? '';
const prefillProduct = params.get('product') ?? '';
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<form id="contact-form" class="space-y-5" novalidate>
  <div class="hidden" aria-hidden="true">
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="field-label mb-2 block">Name</label>
      <input type="text" id="name" name="name" required autocomplete="name" class="input-field input-field--light" />
    </div>
    <div>
      <label for="email" class="field-label mb-2 block">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email" class="input-field input-field--light" />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="projectType" class="field-label mb-2 block">Project type</label>
      <select id="projectType" name="projectType" required class="input-field input-field--light">
        <option value="">Select…</option>
        <option value="mobile" selected={prefillType === 'mobile'}>Mobile app</option>
        <option value="web" selected={prefillType === 'web'}>Website / web app</option>
        <option value="iot" selected={prefillType === 'iot'}>IoT / embedded</option>
        <option value="cloud" selected={prefillType === 'cloud'}>Cloud / backend</option>
        <option value="engineering" selected={prefillType === 'engineering'}>Systems engineering</option>
        <option value="retainer" selected={prefillType === 'retainer'}>Retainer / maintenance</option>
      </select>
    </div>
    <div>
      <label for="budget" class="field-label mb-2 block">Approximate budget</label>
      <select id="budget" name="budget" class="input-field input-field--light">
        <option value="">Select range…</option>
        <option value="under-150k">Under KES 150,000</option>
        <option value="150k-600k">KES 150,000 – 600,000</option>
        <option value="600k-plus">KES 600,000+</option>
        <option value="retainer">Monthly retainer</option>
        <option value="unsure">Not sure yet</option>
      </select>
    </div>
  </div>

  <div>
    <label for="timeline" class="field-label mb-2 block">Timeline</label>
    <select id="timeline" name="timeline" class="input-field input-field--light">
      <option value="">Select…</option>
      <option value="urgent">ASAP (under 4 weeks)</option>
      <option value="1-3months">1–3 months</option>
      <option value="3-6months">3–6 months</option>
      <option value="flexible">Flexible / exploring</option>
    </select>
  </div>

  {(prefillPackage || prefillProduct) && (
    <input type="hidden" name="package" value={prefillPackage || prefillProduct} />
  )}

  <div>
    <label for="message" class="field-label mb-2 block">Project brief</label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="input-field input-field--light resize-y"
      placeholder="What are you building? Users, integrations, constraints…"
    >{prefillPackage ? `Interested in the ${prefillPackage} package.` : prefillProduct ? `Interested in: ${prefillProduct}` : ''}</textarea>
  </div>

  <div class="flex flex-wrap items-center gap-4 pt-2">
    <button type="submit" class="btn-solid cursor-pointer border-0">Send inquiry</button>
    <p id="form-status" class="text-sm text-muted" role="status" aria-live="polite"></p>
  </div>
</form>

<script define:vars={{ web3formsKey }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    if (!web3formsKey) {
      status.textContent = 'Form is not configured. Email hello@versacarte.com directly.';
      return;
    }

    status.textContent = 'Sending…';
    const data = new FormData(form);

    if (data.get('botcheck')) return;

    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const projectType = String(data.get('projectType') ?? '');
    const budget = String(data.get('budget') ?? '');
    const timeline = String(data.get('timeline') ?? '');
    const pkg = String(data.get('package') ?? '');

    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      `Project type: ${projectType || 'not specified'}`,
      `Budget: ${budget || 'not specified'}`,
      `Timeline: ${timeline || 'not specified'}`,
      pkg ? `Package/product: ${pkg}` : '',
      '',
      'Brief:',
      message,
    ].filter(Boolean).join('\n');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: web3formsKey,
          name,
          email,
          subject: `Studio inquiry from ${name} — ${projectType || 'general'}`,
          message: body,
          from_name: 'VersaCarte Studio',
          replyto: email,
          botcheck: '',
        }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        status.textContent = 'Received. We will reply from hello@versacarte.com.';
        form.reset();
      } else {
        status.textContent = result.message ?? 'Something went wrong. Try again or email directly.';
      }
    } catch {
      status.textContent = 'Network issue. Try again when online.';
    }
  });
</script>
