---
interface Props {
  title: string;
  teaser: string;
  problem?: string;
  stack: string[];
  image: string;
  imageAlt?: string;
  slug: string;
  caseStudy?: string | null;
  liveUrl?: string;
}

const { title, teaser, problem, stack, image, imageAlt, slug, caseStudy, liveUrl } = Astro.props;
const link = caseStudy ?? `/work/${slug}`;
const alt = imageAlt ?? `${title} icon`;
---

<article class="work-card" id={slug} data-reveal-scale>
  <div class="work-card__top">
    <div class="work-card__icon">
      <img src={image} alt={alt} width="72" height="72" loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="work-card__body">
    <h3 class="work-card__title">{title}</h3>
    {problem && <p class="work-card__problem">{problem}</p>}
    <p class="work-card__teaser">{teaser}</p>
    <div class="work-card__stack">
      {stack.map((s) => <span>{s}</span>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-4">
      <a href={link} class="link-arrow">{caseStudy ? 'Case study' : 'View project'}</a>
      {liveUrl && (
        <a href={liveUrl} class="link-arrow" target="_blank" rel="noopener noreferrer">Open the app</a>
      )}
    </div>
  </div>
</article>
