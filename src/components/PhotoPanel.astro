---
interface Props {
  src: string;
  alt?: string;
  overlay?: 'hero' | 'section' | 'stats';
  parallax?: boolean;
  class?: string;
}

const { src, alt = '', overlay = 'section', parallax = true, class: className = '' } = Astro.props;
---

<div
  class:list={['photo-panel', `photo-panel--${overlay}`, className]}
  data-photo-panel={parallax ? '' : undefined}
>
  <img
    src={src}
    alt={alt}
    class="photo-panel__img"
    data-parallax-img
    loading={overlay === 'hero' ? 'eager' : 'lazy'}
    decoding="async"
  />
  <div class="photo-panel__shade" aria-hidden="true"></div>
</div>
