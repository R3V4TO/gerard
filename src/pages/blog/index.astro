---
import BaseLayout from '../../layouts/BaseLayout.astro';
import company from '../../data/company.json';
import blog from '../../data/blog.json';
---

<BaseLayout
  title={`Blog | ${company.name}`}
  description="Engineering notes on mobile, IoT, and backend work in East Africa."
>
  <section class="section-studio pt-32 pb-24">
    <div class="container-wide">
      <p class="section-label" data-reveal>{blog.label}</p>
      <h1 class="section-studio__title" data-reveal>{blog.title}</h1>
      <p class="section-studio__body" data-reveal>{blog.subtitle}</p>

      <div class="blog-grid" data-stagger-motion>
        {blog.posts.map((post) => (
          <article class="blog-card">
            <div class="p-6">
              <p class="text-xs text-muted">{post.date} · {post.readTime}</p>
              <h2 class="mt-3 text-xl font-semibold">
                <a href={`/blog/${post.slug}`} class="no-underline hover:text-muted">{post.title}</a>
              </h2>
              <p class="mt-3 text-sm text-muted">{post.excerpt}</p>
              <div class="blog-card__tags mt-4 flex flex-wrap gap-2">
                {post.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <a href={`/blog/${post.slug}`} class="link-arrow mt-5">Read article</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
