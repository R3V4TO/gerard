---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import company from '../data/company.json';
---

<BaseLayout
  title={`Contact | ${company.personName}`}
  description={`Email ${company.personName} about engineering or software work.`}
>
  <section class="section-studio pt-32">
    <div class="container-main">
      <p class="section-label" data-reveal>Contact</p>
      <h1 class="section-studio__title" data-reveal>Email me</h1>
      <p class="section-studio__body" data-reveal>
        I read every note. Include the problem, timeline and how you found this site — including if you came from a CV.
        I reply from {company.email}.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href={`mailto:${company.email}`} class="btn-solid">Open email</a>
        <a href="/cv" class="btn">View CV</a>
      </div>
      <div class="mt-12 max-w-2xl" data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
