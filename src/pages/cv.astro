---
import BaseLayout from '../layouts/BaseLayout.astro';
import company from '../data/company.json';
import cv from '../data/cv.json';
---

<BaseLayout
  title={`CV | ${cv.name}`}
  description={cv.summary}
>
  <section class="section-studio pt-32 pb-24">
    <div class="container-main cv-page">
      <p class="section-label" data-reveal>Curriculum vitae</p>
      <h1 class="section-studio__title" data-reveal>{cv.name}</h1>
      <p class="cv-page__role" data-reveal>{cv.role}</p>
      <p class="section-studio__body" data-reveal>{cv.summary}</p>

      <div class="cv-page__meta" data-reveal>
        <a href={`mailto:${cv.email}`}>{cv.email}</a>
        <span>{cv.location}</span>
        <a href={cv.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={cv.site}>versacarte.com</a>
      </div>

      <div class="cv-page__actions" data-reveal>
        <a href={cv.download} class="btn-solid" download>Download CV</a>
        <a href="/contact" class="btn">Contact</a>
      </div>

      <section class="cv-block" data-reveal>
        <h2>Education</h2>
        {
          cv.education.map((item) => (
            <article class="cv-job">
              <h3>{item.title}</h3>
              <p class="cv-block__place">{item.place} · {item.dates}</p>
              <p>{item.detail}</p>
            </article>
          ))
        }
      </section>

      <section class="cv-block" data-reveal>
        <h2>Professional experience</h2>
        {
          cv.experience.map((job) => (
            <article class="cv-job">
              <h3>{job.title}</h3>
              <p class="cv-block__place">{job.place}</p>
              <p class="cv-block__dates">{job.dates}</p>
              <ul>
                {job.bullets.map((line) => <li>{line}</li>)}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="cv-block" data-reveal>
        <h2>Engineering projects</h2>
        <ul>
          {
            cv.projects.map((project) => (
              <li>
                {project.href !== '/cv' ? (
                  <a
                    href={project.href}
                    target={project.href.startsWith('http') ? '_blank' : undefined}
                    rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >{project.name}</a>
                ) : <strong>{project.name}</strong>}
                <span> — {project.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-block" data-reveal>
        <h2>Technical skills</h2>
        <ul>
          {cv.skills.map((line) => <li>{line}</li>)}
        </ul>
      </section>

      <section class="cv-block" data-reveal>
        <h2>Certifications</h2>
        <ul>
          {cv.certifications.map((line) => <li>{line}</li>)}
        </ul>
      </section>

      <section class="cv-block" data-reveal>
        <h2>Languages</h2>
        <p>{cv.languages}</p>
      </section>

      <section class="cv-block" data-reveal>
        <h2>Community</h2>
        <p>{cv.community}</p>
      </section>
    </div>
  </section>
</BaseLayout>
