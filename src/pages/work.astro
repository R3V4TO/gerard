---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import company from '../data/company.json';
---

<BaseLayout
  title={`Works | ${company.personName}`}
  description="Projects Gerard created: Resphinx, FileSendNX and Smart Traffic Control."
>
  <section class="section-studio blend-section pt-32">
    <div class="blend-wash blend-wash--left" aria-hidden="true">
      <img src="/images/stock/cables.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </div>
    <div class="container-main">
      <p class="section-label" data-reveal>Works</p>
      <h1 class="section-studio__title" data-reveal>Projects I created</h1>
      <p class="section-studio__body" data-reveal>
        These are my builds.
      </p>
      <div class="work-grid mt-12" data-stagger>
        {
          company.work.items.map((item) => (
            <WorkCard
              title={item.title}
              teaser={item.teaser}
              problem={item.problem}
              stack={item.stack}
              image={item.image}
              imageAlt={item.imageAlt}
              slug={item.slug}
              caseStudy={item.caseStudy}
              liveUrl={item.liveUrl}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
