---
import BaseLayout from '../layouts/BaseLayout.astro';
import company from '../data/company.json';
import labs from '../data/labs.json';
---

<BaseLayout
  title={`Labs | ${company.name}`}
  description="Experimental tools, prototypes, and open engineering work from VersaCarte."
>
  <section class="section-studio pt-32">
    <div class="container-wide">
      <p class="section-label" data-reveal>{labs.label}</p>
      <h1 class="section-studio__title" data-reveal>{labs.title}</h1>
      <p class="section-studio__body" data-reveal>{labs.subtitle}</p>

      <div class="mt-8" data-reveal>
        <a href={company.labsUrl} class="btn-solid" target="_blank" rel="noopener noreferrer">
          Open Labs tools
        </a>
      </div>
    </div>
  </section>

  <section class="section-studio section-studio--gray pb-24">
    <div class="container-wide">
      <div class="grid gap-6 lg:grid-cols-3" data-stagger-motion>
        {labs.items.map((item) => (
          <article class="border border-line bg-white p-8">
            <span class="text-xs font-semibold uppercase tracking-widest text-accent-cyan">{item.status}</span>
            <h2 class="mt-3 text-lg font-semibold">{item.name}</h2>
            <p class="mt-3 text-sm text-muted">{item.description}</p>
            <a href={item.href} class="link-arrow mt-5" target="_blank" rel="noopener noreferrer">Try it</a>
          </article>
        ))}
      </div>

      <div class="contact-panel mt-16" data-reveal>
        <h2 class="text-xl font-semibold">{labs.openSource.title}</h2>
        <p class="mt-3 text-sm text-muted">{labs.openSource.description}</p>
        <a href={labs.openSource.href} class="link-arrow mt-4" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
