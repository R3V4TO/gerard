---
import BaseLayout from '../layouts/BaseLayout.astro';
import company from '../data/company.json';
---

<BaseLayout
  title={`What I do | ${company.personName}`}
  description="Electrical and telecommunications engineering plus software Gerard designs and ships."
>
  <section class="section-studio pt-32 pb-24">
    <div class="container-main">
      <p class="section-label" data-reveal>What I do</p>
      <h1 class="section-studio__title" data-reveal>{company.services.title}</h1>
      <div class="luzia-services mt-12" data-stagger>
        {
          company.services.items.map((item) => (
            <article class="luzia-service" id={item.id}>
              <div class="luzia-service__top">
                <h3>{item.title}</h3>
                <a href={item.ctaHref} class="btn">{item.cta}</a>
              </div>
              <p>{item.body}</p>
              <div class="luzia-service__tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
