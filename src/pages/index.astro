---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import TechMarquee from '../components/TechMarquee.astro';
import company from '../data/company.json';

const featured = company.work.items;
const focuses = ['fibre surveys', 'Resphinx', 'firmware', 'the traffic project'];
---

<BaseLayout>
  <section id="hero" class="luzia-hero scroll-mt-24">
    <div class="blend-wash blend-wash--right" aria-hidden="true">
      <img src={company.hero.image} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    </div>
    <div class="container-wide luzia-hero__copy">
      <p class="luzia-hero__note" data-hero-line>{company.tagline}, {company.location}</p>
      <h1 class="luzia-hero__title" data-hero-line>{company.hero.title}</h1>
      <p class="luzia-hero__body" data-hero-line>{company.hero.subtitle}</p>
      <p class="hero-live" data-hero-line>
        <time data-nairobi-clock datetime="">Nairobi</time>
        <span class="hero-live__rule" aria-hidden="true"></span>
        <span>
          Lately
          <span class="hero-live__word" data-rotate>{focuses[0]}</span>
        </span>
      </p>
      <div class="luzia-hero__actions" data-hero-line>
        <a href="#work" class="btn-solid">The projects</a>
        <a href="/about" class="btn">About</a>
      </div>
    </div>
  </section>

  <TechMarquee />

  <section id="work" class="section-studio blend-section scroll-mt-24">
    <div class="blend-wash blend-wash--left" aria-hidden="true">
      <img src="/images/stock/cables.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </div>
    <div class="container-wide">
      <div class="luzia-section-head" data-reveal>
        <div>
          <p class="section-label">{company.work.label}</p>
          <h2 class="section-studio__title">{company.work.title}</h2>
        </div>
      </div>
      <p class="section-studio__body" data-reveal>{company.work.body}</p>
      <div class="work-grid luzia-work-grid" data-stagger-motion>
        {
          featured.map((item) => (
            <WorkCard
              title={item.title}
              teaser={item.teaser}
              problem={item.problem}
              stack={item.stack}
              image={item.image}
              imageAlt={item.imageAlt}
              slug={item.slug}
              caseStudy={item.caseStudy}
              liveUrl={item.liveUrl}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="services" class="section-studio section-studio--gray blend-section blend-on-surface scroll-mt-24">
    <div class="blend-wash" aria-hidden="true">
      <img src="/images/stock/panel.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </div>
    <div class="container-wide">
      <p class="section-label" data-reveal>{company.services.label}</p>
      <h2 class="section-studio__title" data-reveal>{company.services.title}</h2>
      <div class="practice" data-practice>
        <div class="practice__list" role="tablist" aria-label="Background">
          {
            company.services.items.map((item, index) => (
              <button
                type="button"
                class:list={['practice__tab', { 'is-active': index === 0 }]}
                role="tab"
                id={`practice-tab-${item.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`practice-panel-${item.id}`}
                data-practice-tab
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                {item.title}
              </button>
            ))
          }
        </div>
        <div class="practice__stage">
          {
            company.services.items.map((item, index) => (
              <article
                class="practice__panel"
                role="tabpanel"
                id={`practice-panel-${item.id}`}
                aria-labelledby={`practice-tab-${item.id}`}
                hidden={index === 0 ? undefined : true}
                data-practice-panel
              >
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <div class="luzia-service__tags">
                  {item.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <a href={item.ctaHref} class="btn">{item.cta}</a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="process" class="section-studio blend-section scroll-mt-24">
    <div class="blend-wash blend-wash--low" aria-hidden="true">
      <img src="/images/stock/laptop-desk.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </div>
    <div class="container-wide luzia-process">
      <div>
        <p class="section-label" data-reveal>{company.process.label}</p>
        <h2 class="section-studio__title" data-reveal>{company.process.title}</h2>
        <ol class="luzia-process__steps">
          {
            company.process.steps.map((step) => (
              <li data-reveal>
                <span>{step.n}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="luzia-close blend-section scroll-mt-24">
    <div class="blend-wash blend-wash--right" aria-hidden="true">
      <img src="/images/stock/laptop-work.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </div>
    <div class="container-wide luzia-close__content">
      <h2 data-reveal>Email is enough if you want to talk about the work</h2>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href={`mailto:${company.email}`} class="btn-solid">Email me</a>
        <a href="/about" class="btn">About</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const clock = document.querySelector<HTMLTimeElement>('[data-nairobi-clock]');
  const word = document.querySelector<HTMLElement>('[data-rotate]');
  const focuses = ['fibre surveys', 'Resphinx', 'firmware', 'the traffic project'];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const paintClock = (): void => {
    if (!clock) return;
    const now = new Date();
    const time = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
      timeZone: 'Africa/Nairobi',
    }).format(now);
    clock.dateTime = now.toISOString();
    clock.textContent = `Nairobi · ${time}`;
  };

  paintClock();
  window.setInterval(paintClock, 30_000);

  if (word && !reduced) {
    let index = 0;
    window.setInterval(() => {
      index = (index + 1) % focuses.length;
      word.classList.add('is-out');
      window.setTimeout(() => {
        word.textContent = focuses[index];
        word.classList.remove('is-out');
      }, 180);
    }, 2400);
  }

  const practice = document.querySelector<HTMLElement>('[data-practice]');
  if (practice) {
    const tabs = [...practice.querySelectorAll<HTMLButtonElement>('[data-practice-tab]')];
    const panels = [...practice.querySelectorAll<HTMLElement>('[data-practice-panel]')];
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const activate = (index: number): void => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        panels[i].hidden = !on;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      if (canHover) tab.addEventListener('mouseenter', () => activate(index));
    });
  }
</script>
