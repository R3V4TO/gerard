---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import FaqList from '../components/FaqList.astro';
import company from '../data/company.json';

const featured = company.work.items;
---

<BaseLayout>
  <section id="hero" class="luzia-hero scroll-mt-24">
    <div class="container-wide luzia-hero__grid">
      <div class="luzia-hero__photo" data-hero-line>
        <img
          src={company.hero.image}
          alt={company.hero.imageAlt}
          width="960"
          height="768"
          fetchpriority="high"
          decoding="async"
        />
        <div class="luzia-hero__mark">
          <img src={`${company.logo.markLight}?v=4`} alt="" width="72" height="114" decoding="async" />
        </div>
      </div>
      <div class="luzia-hero__copy">
        <h1 class="luzia-hero__title" data-hero-line>{company.hero.title}</h1>
        <p class="luzia-hero__body" data-hero-line>{company.hero.subtitle}</p>
        <div class="luzia-hero__actions" data-hero-line>
          <a href={`mailto:${company.email}`} class="btn-solid">Email me</a>
          <a href="/cv" class="btn">View CV</a>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section-studio scroll-mt-24">
    <div class="container-wide">
      <div class="luzia-section-head" data-reveal>
        <div>
          <p class="section-label">{company.work.label}</p>
          <h2 class="section-studio__title">{company.work.title}</h2>
        </div>
        <a href="/work" class="btn">All works</a>
      </div>
      <p class="section-studio__body" data-reveal>{company.work.body}</p>
      <div class="work-grid luzia-work-grid" data-stagger-motion>
        {
          featured.map((item) => (
            <WorkCard
              title={item.title}
              teaser={item.teaser}
              problem={item.problem}
              status={item.status}
              stack={item.stack}
              image={item.image}
              cover={item.cover}
              imageAlt={item.imageAlt}
              slug={item.slug}
              caseStudy={item.caseStudy}
              liveUrl={item.liveUrl}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="services" class="section-studio section-studio--gray scroll-mt-24">
    <div class="container-wide">
      <p class="section-label" data-reveal>{company.services.label}</p>
      <h2 class="section-studio__title" data-reveal>{company.services.title}</h2>
      <div class="luzia-services" data-stagger-motion>
        {
          company.services.items.map((item) => (
            <article class="luzia-service" id={item.id}>
              <div class="luzia-service__top">
                <h3>{item.title}</h3>
                <a href={item.ctaHref} class="btn">{item.cta}</a>
              </div>
              <p>{item.body}</p>
              <div class="luzia-service__tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="process" class="section-studio scroll-mt-24">
    <div class="container-wide luzia-process">
      <div>
        <p class="section-label" data-reveal>{company.process.label}</p>
        <h2 class="section-studio__title" data-reveal>{company.process.title}</h2>
        <ol class="luzia-process__steps">
          {
            company.process.steps.map((step) => (
              <li data-reveal>
                <span>{step.n}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="luzia-process__photo" data-reveal>
        <img src={company.process.image} alt={company.process.imageAlt} width="800" height="800" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <FaqList />

  <section class="luzia-close scroll-mt-24">
    <div class="luzia-close__media" aria-hidden="true">
      <img src={company.why.image} alt="" width="900" height="600" loading="lazy" decoding="async" />
    </div>
    <div class="container-wide luzia-close__content">
      <h2 data-reveal>Write to me, and I will take it from there</h2>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href={`mailto:${company.email}`} class="btn-light">Email me</a>
        <a href="/cv" class="btn-light">Open CV</a>
      </div>
    </div>
  </section>
</BaseLayout>
