---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientMotion from '../components/ClientMotion.astro';
import SiteUtilities from '../components/SiteUtilities.astro';
import EmailButton from '../components/EmailButton.astro';
import PostHog from '../components/PostHog.astro';
import company from '../data/company.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${company.name} | ${company.tagline}`,
  description = company.hero.subtitle,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <Header />
    <main class="pt-0">
      <slot />
    </main>
    <Footer />
    <SiteUtilities />
    <EmailButton />
    <ClientMotion />
    <script is:inline>
      (function(){try{var t=localStorage.getItem('versacarte-theme');if(t)document.documentElement.dataset.theme=t;var l=localStorage.getItem('versacarte-lang');if(l){document.documentElement.lang=l;document.documentElement.dir=l==='ar'?'rtl':'ltr'}}catch(e){}})();
    </script>
  </body>
</html>
