---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientMotion from '../components/ClientMotion.astro';
import SiteUtilities from '../components/SiteUtilities.astro';
import EmailButton from '../components/EmailButton.astro';
import PostHog from '../components/PostHog.astro';
import company from '../data/company.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = company.seoTitle ?? `${company.personName} | ${company.tagline}`,
  description = company.seoDescription ?? company.hero.subtitle,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const faviconSvg = '/favicon.svg';
const faviconPng = '/favicon-32.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="icon" href={faviconPng} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL(company.logo.full, Astro.site).href} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.personName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    {isHome && <link rel="preload" as="image" href={company.hero.image} fetchpriority="high" />}
  </head>
  <body data-home={isHome || undefined}>
    <Header />
    <main class="pt-0">
      <slot />
    </main>
    <Footer />
    <SiteUtilities />
    <EmailButton />
    <ClientMotion />
    <PostHog />
    <script is:inline>
      (function(){try{var t=localStorage.getItem('versacarte-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}})();
    </script>
  </body>
</html>
